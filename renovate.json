{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^config\\.yaml$"],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/(?<depName>[^/]+/[^/]+)/(?<currentDigest>[a-f0-9]{40})/"
      ],
      "datasource": "git-refs",
      "currentValue": "main"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": ["fullsend-ai/agents"],
      "postUpgradeTasks": {
        "commands": ["bash hack/update-agent-hashes.sh {{{newDigest}}}"],
        "fileFilters": ["config.yaml"],
        "executionMode": "update"
      }
    }
  ],
  "allowedPostUpgradeCommands": ["^bash hack/update-agent-hashes\\.sh "]
}
