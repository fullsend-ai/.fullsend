export GH_TOKEN=${GH_TOKEN}
export CLASSIFY_SOURCE_REPO="${CLASSIFY_SOURCE_REPO}"
export CLASSIFY_MODE="${CLASSIFY_MODE}"
export CLASSIFY_ISSUE_NUMBER="${CLASSIFY_ISSUE_NUMBER}"
export CLASSIFY_FILTER_CATEGORY="${CLASSIFY_FILTER_CATEGORY}"
export CLASSIFY_SCREEN_ISSUES="${CLASSIFY_SCREEN_ISSUES}"
export CLASSIFY_CATEGORIES_PATH="${CLASSIFY_CATEGORIES_PATH}"
export CLASSIFY_PROJECT_NUMBER="${CLASSIFY_PROJECT_NUMBER}"
export CLASSIFY_FIELD_NAME="${CLASSIFY_FIELD_NAME}"
export CLASSIFY_PROJECT_TOKEN="${CLASSIFY_PROJECT_TOKEN}"
export CLASSIFY_MIN_CONFIDENCE="${CLASSIFY_MIN_CONFIDENCE}"
export CLASSIFY_DRY_RUN="${CLASSIFY_DRY_RUN}"

# Normalize sentinel values used to satisfy fullsend runner_env validation.
[ "${CLASSIFY_ISSUE_NUMBER}" = "0" ] && export CLASSIFY_ISSUE_NUMBER=""
[ "${CLASSIFY_FILTER_CATEGORY}" = "__all__" ] && export CLASSIFY_FILTER_CATEGORY=""
[ "${CLASSIFY_PROJECT_TOKEN}" = "__none__" ] && export CLASSIFY_PROJECT_TOKEN=""
